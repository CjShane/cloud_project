NODE_ENV=development
PORT=3000

# Runtime database connection used by the Next.js app.
DATABASE_URL=mysql://bible_app_user:replace-with-app-password@bible-app.c8zqus4i6bu5.us-east-1.rds.amazonaws.com:3306/bible_app

# Auth/session configuration.
AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=scripture_session
SESSION_DAYS=30

# One-time MySQL bootstrap values. Do not keep admin credentials on EC2 after bootstrap.
MYSQL_ADMIN_URL=mysql://admin-user:admin-password@bible-app.c8zqus4i6bu5.us-east-1.rds.amazonaws.com:3306
MYSQL_DATABASE=bible_app
MYSQL_APP_USER=bible_app_user
MYSQL_APP_PASSWORD=replace-with-app-password
